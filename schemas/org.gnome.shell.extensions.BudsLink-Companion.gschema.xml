<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="gnome-shell-extensions">
    <schema path="/org/gnome/shell/extensions/BudsLink-Companion/" id="org.gnome.shell.extensions.BudsLink-Companion">
        <key name="indicator-type" type="i">
            <default>1</default>
            <summary>0: System Tray, 1: Panel Button</summary>
        </key>
        <key name="panel-button-single-indicator" type="b">
            <default>false</default>
            <summary>"enable single device indicator"</summary>
        </key>
        <key name="enable-multi-indicator-mode" type="b">
            <default>false</default>
            <summary>"For one device display each Bat level as seperate indicator"</summary>
        </key>
        <key name="enable-on-hover-mode" type="b">
            <default>true</default>
            <summary>"enable use of on hover mode"</summary>
        </key>
        <key name="on-hover-delay" type="i">
            <default>1000</default>
            <summary>"onhover delay time in milliseconds"</summary>
        </key>
        <key name="enable-tooltip" type="b">
            <default>true</default>
            <summary>"Enable Tooltips"</summary>
        </key>
        <key name="default-selected-path" type="s">
            <default>''</default>
            <summary>"Store path if activated"</summary>
        </key>
        <key name="disable-level-in-icon" type="b">
            <default>false</default>
            <summary>Removes level indicator from icon </summary>
        </key>
        <key name="enable-battery-indicator-text" type="b">
            <default>false</default>
            <summary>Show text next to icon in system tray with device battery level</summary>
        </key>
        <key name="indicator-size" type="i">
            <default>100</default>
            <summary>Change size of icon widget</summary>
        </key>
        <key name="level-indicator-type" type="i">
            <default>0</default>
            <summary>"Level type"</summary>
        </key>
        <key name="level-bar-position" type="i">
            <default>1</default>
            <summary>"Bar position"</summary>
        </key>
        <key name="level-indicator-color" type="i">
            <default>1</default>
            <summary>"Level Color"</summary>
        </key>
        <key name="level-indicator-custom-colors" type="as">
            <default>['#ff7800', '#ff7800', '#15c931', '#15c931', '#15c931',
              '#15c931', '#15c931', '#15c931', '#15c931', '#15c931']</default>
            <summary>"Custom colors for each 10% battery-level bucket (100→10)"</summary>
        </key>
        <key name="circle-widget-color" type="i">
            <default>1</default>
            <summary>"Circle widget Color"</summary>
        </key>
        <key name="circle-widget-custom-colors" type="as">
            <default>['#ff7800', '#ff7800', '#15c931', '#15c931', '#15c931',
              '#15c931', '#15c931', '#15c931', '#15c931', '#15c931']</default>
            <summary>"Custom colors for each 10% battery-level bucket (100→10)"</summary>
        </key>
    </schema>
</schemalist>
